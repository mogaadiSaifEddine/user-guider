generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Dashboard side ----------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  // Public key embedded in the snippet; identifies the workspace to the SDK.
  publicKey String   @unique
  // Secret used to verify user identity (HMAC-SHA256 of the user id).
  secretKey String
  // When true, /api/sdk calls must carry a valid user hash.
  requireIdentityVerification Boolean @default(false)
  // { primaryColor, textColor, backgroundColor, radius, fontFamily }
  theme     Json
  createdAt DateTime @default(now())

  memberships Membership[]
  guides      Guide[]
  endUsers    EndUser[]
  events      Event[]
  assets      Asset[]
}

enum Role {
  OWNER
  EDITOR
}

model Membership {
  userId      String
  workspaceId String
  role        Role      @default(EDITOR)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

enum GuideType {
  TOUR
  CHECKLIST
  ANNOUNCEMENT
  HOTSPOT
}

enum GuideStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Guide {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  type        GuideType
  status      GuideStatus @default(DRAFT)
  // Draft content edited in the dashboard and builder (shape depends on type, see src/lib/guide-schema.ts).
  content     Json
  // Snapshot served to end users; copied from `content` on publish.
  publishedContent Json?
  // { urlRules, userRules, trigger, delaySeconds, frequency }
  targeting   Json
  priority    Int         @default(0)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  progress  GuideProgress[]
  events    Event[]

  @@index([workspaceId, status])
}

// Images uploaded for guide content, served publicly at /api/assets/<id>.
model Asset {
  id          String   @id @default(cuid())
  workspaceId String
  mimeType    String   @db.VarChar(100)
  size        Int
  data        Bytes    @db.MediumBlob
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------- End-user side (people using the customer's site) ----------

model EndUser {
  id          String   @id @default(cuid())
  workspaceId String
  // Id given by the host site via identify(), or an anonymous id generated by the SDK.
  externalId  String   @db.VarChar(191)
  anonymous   Boolean  @default(false)
  attributes  Json
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  progress  GuideProgress[]
  events    Event[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, lastSeenAt])
}

enum ProgressStatus {
  STARTED
  COMPLETED
  DISMISSED
}

model GuideProgress {
  endUserId      String
  guideId        String
  status         ProgressStatus @default(STARTED)
  currentStep    Int            @default(0)
  // Checklist item ids the user has completed.
  completedItems Json
  updatedAt      DateTime       @updatedAt

  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  guide   Guide   @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([endUserId, guideId])
  @@index([guideId, status])
}

model Event {
  id          BigInt   @id @default(autoincrement())
  workspaceId String
  endUserId   String
  guideId     String?
  // guide_shown | step_viewed | guide_completed | guide_dismissed | checklist_item_completed | hotspot_opened | custom
  type        String   @db.VarChar(64)
  // Custom event name (track()) or checklist item id.
  name        String?  @db.VarChar(191)
  stepIndex   Int?
  url         String?  @db.VarChar(1024)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endUser   EndUser   @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  guide     Guide?    @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([guideId, type, createdAt])
  @@index([endUserId])
}
