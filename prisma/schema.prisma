generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: DATABASE_URL is the pooled (-pooler) URL, DIRECT_URL the direct one for migrations.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Dashboard side ----------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

model Workspace {
  id                          String   @id @default(cuid())
  name                        String
  // Public key embedded in the snippet; identifies the workspace to the SDK.
  publicKey                   String   @unique
  // Secret used to verify user identity (HMAC-SHA256 of the user id).
  secretKey                   String
  // When true, /api/sdk calls must carry a valid user hash.
  requireIdentityVerification Boolean  @default(false)
  // { primaryColor, textColor, backgroundColor, radius, fontFamily }
  theme                       Json
  // What the product is and who uses it; given to the AI when drafting guides.
  aiContext                   String?  @db.Text
  // Which identify() attributes hold the user's company (e.g. publisher / publisher_alias).
  // Null: look for common names, see src/lib/companies.ts.
  companyIdAttribute          String?  @db.VarChar(100)
  companyNameAttribute        String?  @db.VarChar(100)
  // BCP 47 tags guides are translated into, besides English (the source and the fallback).
  // Null: English only. See src/lib/i18n.ts.
  languages                   Json?
  // Overrides of the SDK's interface text (Close, Back, Search…): { [locale]: { [key]: text } }.
  uiStrings                   Json?
  createdAt                   DateTime @default(now())

  memberships   Membership[]
  guides        Guide[]
  endUsers      EndUser[]
  events        Event[]
  assets        Asset[]
  activity      UserActivity[]
  surveyAnswers SurveyAnswer[]
  kbCollections KbCollection[]
  kbArticles    KbArticle[]
}

enum Role {
  OWNER
  EDITOR
}

model Membership {
  userId      String
  workspaceId String
  role        Role      @default(EDITOR)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
}

enum GuideType {
  TOUR
  CHECKLIST
  ANNOUNCEMENT
  HOTSPOT
  SURVEY
  RESOURCE_CENTER
}

enum GuideStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Guide {
  id                    String      @id @default(cuid())
  workspaceId           String
  name                  String
  type                  GuideType
  status                GuideStatus @default(DRAFT)
  // Draft content edited in the dashboard and builder (shape depends on type, see src/lib/guide-schema.ts).
  content               Json
  // Snapshot served to end users; copied from `content` on publish.
  publishedContent      Json?
  // { [locale]: { [fieldKey]: { text, source } } }; fieldKey and source explained in src/lib/i18n.ts.
  translations          Json?
  publishedTranslations Json?
  // { urlRules, userRules, trigger, delaySeconds, frequency }
  targeting             Json
  priority              Int         @default(0)
  publishedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  progress      GuideProgress[]
  events        Event[]
  surveyAnswers SurveyAnswer[]

  @@index([workspaceId, status])
}

// Images uploaded for guide content, served publicly at /api/assets/<id>.
model Asset {
  id          String   @id @default(cuid())
  workspaceId String
  mimeType    String   @db.VarChar(100)
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------- Knowledge base ----------

enum KbSource {
  MANUAL
  ZENDESK
  INTERCOM
}

enum KbStatus {
  DRAFT
  PUBLISHED
}

model KbCollection {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String   @db.VarChar(191)
  description  String?  @db.Text
  position     Int      @default(0)
  // { [locale]: { name, description } }
  translations Json?
  source       KbSource @default(MANUAL)
  // Id in Zendesk / Intercom, so a re-import updates instead of duplicating.
  externalId   String?  @db.VarChar(64)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  articles  KbArticle[]

  @@unique([workspaceId, source, externalId])
  @@index([workspaceId, position])
}

model KbArticle {
  id           String   @id @default(cuid())
  workspaceId  String
  collectionId String?
  status       KbStatus @default(DRAFT)
  // English title, for lists.
  title        String   @db.VarChar(255)
  // English: { title, summary, blocks }, see src/lib/kb.ts.
  content      Json
  // { [locale]: { title, summary, blocks, source } }; source = hash of the English content it was made from.
  translations Json?
  // Lower-cased words of every language, for search.
  searchText   String?  @db.Text
  position     Int      @default(0)
  source       KbSource @default(MANUAL)
  externalId   String?  @db.VarChar(64)
  externalUrl  String?  @db.VarChar(1024)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  collection KbCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, source, externalId])
  @@index([workspaceId, status])
  @@index([collectionId])
}

// ---------- End-user side (people using the customer's site) ----------

model EndUser {
  id          String   @id @default(cuid())
  workspaceId String
  // Id given by the host site via identify(), or an anonymous id generated by the SDK.
  externalId  String   @db.VarChar(191)
  anonymous   Boolean  @default(false)
  attributes  Json
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  // Company (publisher) taken from attributes, see src/lib/companies.ts.
  companyId   String?  @db.VarChar(191)
  companyName String?  @db.VarChar(191)
  // Last browser context seen by /api/sdk/init.
  browser     String?  @db.VarChar(40)
  os          String?  @db.VarChar(40)
  // desktop | mobile | tablet
  device      String?  @db.VarChar(20)
  // BCP 47 tag from navigator.language, e.g. en-US.
  language    String?  @db.VarChar(35)
  timezone    String?  @db.VarChar(64)

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  progress      GuideProgress[]
  events        Event[]
  activity      UserActivity[]
  surveyAnswers SurveyAnswer[]

  @@unique([workspaceId, externalId])
  @@index([workspaceId, lastSeenAt])
  @@index([workspaceId, firstSeenAt])
  @@index([workspaceId, companyId])
}

// One row per user per UTC day the snippet loaded. Drives daily/weekly/monthly active users.
model UserActivity {
  endUserId   String
  workspaceId String
  day         DateTime @db.Date

  endUser   EndUser   @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([endUserId, day])
  @@index([workspaceId, day])
}

// Latest answer of a user to one survey question.
model SurveyAnswer {
  id          BigInt   @id @default(autoincrement())
  workspaceId String
  guideId     String
  endUserId   String
  questionId  String   @db.VarChar(64)
  // number (nps, rating), option id (single), option ids (multiple) or text.
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  guide     Guide     @relation(fields: [guideId], references: [id], onDelete: Cascade)
  endUser   EndUser   @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@unique([guideId, endUserId, questionId])
  @@index([guideId, updatedAt])
  @@index([workspaceId])
  @@index([endUserId])
}

enum ProgressStatus {
  STARTED
  COMPLETED
  DISMISSED
}

model GuideProgress {
  endUserId      String
  guideId        String
  status         ProgressStatus @default(STARTED)
  currentStep    Int            @default(0)
  // Checklist item ids the user has completed.
  completedItems Json
  updatedAt      DateTime       @updatedAt

  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  guide   Guide   @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@id([endUserId, guideId])
  @@index([guideId, status])
}

model Event {
  id          BigInt   @id @default(autoincrement())
  workspaceId String
  endUserId   String
  guideId     String?
  // guide_shown | step_viewed | guide_completed | guide_dismissed | checklist_item_completed | hotspot_opened | survey_answered | resource_clicked | custom
  type        String   @db.VarChar(64)
  // Custom event name (track()) or checklist item id.
  name        String?  @db.VarChar(191)
  stepIndex   Int?
  url         String?  @db.VarChar(1024)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endUser   EndUser   @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  guide     Guide?    @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([guideId, type, createdAt])
  @@index([endUserId])
}
