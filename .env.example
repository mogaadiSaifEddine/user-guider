# PostgreSQL. On Neon, DATABASE_URL is the pooled connection string (host contains "-pooler")
# and DIRECT_URL the direct one, which Prisma uses for migrations. Both need sslmode=require.
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/guides?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/guides?sslmode=require"
# Without a pooler, set both to the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/guides?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/guides?sslmode=require"
# Signs dashboard session cookies and builder tokens. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL of this app; the embed snippet loads sdk.js and calls the API from here.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
