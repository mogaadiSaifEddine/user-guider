# MySQL connection (docker compose up -d starts one on port 3307)
DATABASE_URL="mysql://root:root@localhost:3307/guides"
# Signs dashboard session cookies and builder tokens. Use a long random string in production.
AUTH_SECRET="change-me-to-a-long-random-string"
# Public URL of this app; the embed snippet loads sdk.js and calls the API from here.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: enables AI drafting in the builder (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Optional: Gemini model id (default gemini-3.8-flash)
GEMINI_MODEL=""
# Optional: how long Gemini 3 models think before answering: LOW (default, ~5 s), MEDIUM or HIGH
GEMINI_THINKING=""
